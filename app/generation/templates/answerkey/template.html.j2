<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<script>
window.MathJax = {
  tex: {
    inlineMath: [['\\(', '\\)']],
    displayMath: [['\\[', '\\]']],
    processEscapes: true,
    tags: 'none'
  },
  svg: { fontCache: 'global' },
  options: {
    enableMenu: false,
    processHtmlClass: 'tex2jax_process'
  }
};
</script>
<script src="mathjax/tex-chtml.js" async></script>
<style>{{ css }}</style>
</head>
<body>

<div class="watermark-layer">
  {% if watermark_img %}
    <img class="watermark" src="{{ watermark_img }}" style="opacity:{{ watermark.opacity or 0.15 }};width:{{ (watermark.scale or 0.4) * 100 }}%;transform:rotate({{ watermark.rotation or 0 }}deg)">
  {% else %}
    <div class="watermark-text">STUDIQUE</div>
  {% endif %}
</div>

<div class="content">

  <section class="cover">
    <div class="cover-inner">
      <img class="cover-logo" src="{{ logo_url or '' }}" alt="Studique">
      <div class="cover-brand">STUDIQUE</div>
      <div class="cover-sub">PREVIOUS YEAR QUESTIONS</div>
      <div class="cover-title">{{ meta.bank_title }}</div>
      <div class="cover-rule"></div>
      <table class="meta-table">
        <tr><td class="mt-label">Subject</td><td class="mt-value">{{ meta.subject_name }}{% if meta.subject_code %} ({{ meta.subject_code }}){% endif %}</td></tr>
        <tr><td class="mt-label">Course</td><td class="mt-value">{{ meta.course }}</td></tr>
        <tr><td class="mt-label">Semester</td><td class="mt-value">{{ meta.semester }}</td></tr>
        <tr><td class="mt-label">Coverage</td><td class="mt-value">{{ meta.coverage }}</td></tr>
        <tr><td class="mt-label">PYQ Years</td><td class="mt-value">{{ meta.years | join(', ') if meta.years else '—' }}</td></tr>
        <tr><td class="mt-label">Questions</td><td class="mt-value">{{ meta.total_questions }} ({{ meta.answered_count }} answered)</td></tr>
      </table>
      <div class="cover-rule"></div>
      <div class="cover-foot">Model Solutions &middot; Studique</div>
      {% if meta.notes %}<div class="cover-notes">{{ meta.notes }}</div>{% endif %}
    </div>
  </section>

  {% for group in groups %}
  <section class="group">
    <div class="group-title">{{ group.title }}</div>
    {% for q in group.questions %}
    <div class="qa">
      <div class="q-head">
        <span class="q-num">{{ q.numbering }}.</span>
        <span class="q-text">{{ q.text or '' }}</span>
        {% if q.marks %}<span class="q-marks">{{ q.marks }}</span>{% endif %}
      </div>
      {% if q.options %}
      <div class="q-opts">{% for o in q.options %}<span class="opt">{{ o }}</span>{% endfor %}</div>
      {% endif %}
      {% if q.subs %}
      <div class="q-subs">{% for s in q.subs %}<span class="q-sub">{{ s.label or '' }} {{ s.text }}{% if s.is_or_alternative %} (OR){% endif %}</span>{% endfor %}</div>
      {% endif %}

      {% set ans = answer_map.get(q.id) %}
      {% if ans %}
        {% if ans.correct_option %}<div class="correct-opt">Correct option: <b>({{ ans.correct_option }})</b></div>{% endif %}
        <div class="steps">
          {% for s in ans.steps %}<div class="step">{{ loop.index }}. {{ s }}</div>{% endfor %}
        </div>
        {% if ans.final_answer %}<div class="final-ans">Answer: {{ ans.final_answer }}</div>{% endif %}
      {% else %}
        <div class="no-ans">[Answer not yet generated]</div>
      {% endif %}
    </div>
    {% endfor %}
  </section>
  {% endfor %}

</div>

</body>
</html>
