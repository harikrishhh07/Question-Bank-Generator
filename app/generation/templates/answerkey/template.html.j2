<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<script>
window.MathJax = {
  tex: {
    inlineMath: [['\\(', '\\)']],
    displayMath: [['\\[', '\\]']],
    processEscapes: true,
    tags: 'none'
  },
  svg: { fontCache: 'global' },
  options: { enableMenu: false }
};
</script>
<script src="../mathjax/tex-chtml.js" async></script>
<style>{{ css }}</style>
</head>
<body>

<div class="watermark-layer">
  {% if watermark_img %}
    <img class="watermark" src="{{ watermark_img }}" style="opacity:{{ watermark.opacity or 0.15 }};width:{{ (watermark.scale or 0.4) * 100 }}%;transform:rotate({{ watermark.rotation or 0 }}deg)">
  {% else %}
    <div class="watermark-text">STUDIQUE</div>
  {% endif %}
</div>

<div class="content">

  <!-- COVER -->
  <section class="cover">
    <div class="cover-inner">
      <img class="cover-logo" src="{{ logo_url or '' }}" alt="Studique" onerror="this.style.display='none'">
      <div class="cover-brand">STUDIQUE</div>
      <div class="cover-sub">MODEL ANSWERS</div>
      <div class="cover-title">{{ meta.bank_title }}</div>
      <div class="cover-rule"></div>
      <table class="meta-table">
        <tr><td class="mt-label">Subject</td><td class="mt-value">{{ meta.subject_name }}{% if meta.subject_code %} ({{ meta.subject_code }}){% endif %}</td></tr>
        <tr><td class="mt-label">Course</td><td class="mt-value">{{ meta.course }}</td></tr>
        <tr><td class="mt-label">Semester</td><td class="mt-value">{{ meta.semester }}</td></tr>
        <tr><td class="mt-label">Coverage</td><td class="mt-value">{{ meta.coverage }}</td></tr>
        <tr><td class="mt-label">PYQ Years</td><td class="mt-value">{{ meta.years | join(', ') if meta.years else '—' }}</td></tr>
        <tr><td class="mt-label">Questions</td><td class="mt-value">{{ meta.total_questions }} questions &middot; {{ meta.answered_count }} answered</td></tr>
        <tr><td class="mt-label">Compiled</td><td class="mt-value">{{ meta.compiled_on }}</td></tr>
      </table>
      <div class="cover-rule"></div>
      <div class="cover-foot">Model Solutions &middot; Studique</div>
      {% if meta.notes %}<div class="cover-notes">{{ meta.notes }}</div>{% endif %}
    </div>
  </section>

  <!-- QUESTIONS + ANSWERS -->
  {% for group in groups %}
  <section class="group">
    <div class="group-title">{{ group.title }}</div>

    {% for q in group.questions %}
    <div class="qa-block">

      <!-- Question -->
      <div class="q-head">
        <span class="q-num">{{ q.numbering }}.</span>
        <span class="q-text">{{ q.text | safe }}</span>
        {% if q.marks %}<span class="q-marks">{{ q.marks }} Mark{{ 's' if q.marks != 1 }}</span>{% endif %}
      </div>

      {% if q.options %}
      <div class="q-opts">
        {% for o in q.options %}
        <span class="opt">
          <b>({{ ["A","B","C","D","E"][loop.index0] }})&nbsp;</b>{{ o | safe }}
        </span>
        {% endfor %}
      </div>
      {% endif %}

      {% if q.subs %}
      <div class="q-subs">
        {% for s in q.subs %}
        <div class="q-sub">
          {% if s.is_or_alternative %}<div class="or-bar">— OR —</div>{% endif %}
          <span class="sub-lbl">{{ s.label or '' }}</span>
          <span class="sub-txt">{{ s.text | safe }}</span>
          {% if s.marks %}<span class="sub-mk">({{ s.marks }})</span>{% endif %}
        </div>
        {% endfor %}
      </div>
      {% endif %}

      <!-- Answer -->
      {% set ans = answer_map.get(q.id) %}
      {% if ans %}
        <div class="answer-block">
          <div class="ans-label">✦ Model Answer</div>
          {% if ans.correct_option %}
          <div class="correct-opt">Correct option: <strong>({{ ans.correct_option }})</strong></div>
          {% endif %}
          {% if ans.steps %}
          <div class="steps">
            {% for step in ans.steps %}
            <div class="step"><span class="step-n">{{ loop.index }}.</span> <span class="step-txt">{{ step | safe }}</span></div>
            {% endfor %}
          </div>
          {% endif %}
          {% if ans.final_answer %}
          <div class="final-ans">∴ &nbsp;{{ ans.final_answer | safe }}</div>
          {% endif %}
        </div>
      {% else %}
        <div class="no-ans">⚠ Answer not yet generated — run "Generate Answers" first.</div>
      {% endif %}

    </div>
    {% endfor %}

  </section>
  {% endfor %}

</div>

</body>
</html>
